# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Set when behind a load balancer / reverse proxy (e.g. 1 or "loopback").
TRUST_PROXY=
# Swagger UI at /api/docs. Set to false to hide it in production.
SWAGGER_ENABLED=true

# Public URL of the web app (used in email links).
APP_URL=http://localhost:3000
# Local Postgres from backend/docker-compose.yml.
DATABASE_URL=postgresql://grooveli:grooveli@localhost:5440/grooveli?schema=public
SESSION_TTL_DAYS=14
# Long random secret (e.g. `openssl rand -hex 32`). Protects anonymous-survey markers.
HASH_SECRET=grooveli-dev-hash-secret-change-me
# Comma-separated words refused in community posts and messages (Trust & Safety owns this list).
CONTENT_BLOCKLIST=
# Defaults to true in production. Must be true behind HTTPS.
COOKIE_SECURE=
# e.g. .grooveli.com when web and API are on sibling subdomains.
COOKIE_DOMAIN=
# Have I Been Pwned check on new passwords. Defaults to true in production.
PASSWORD_BREACH_CHECK=

# SMTP: Mailpit locally (http://localhost:8025); your provider's SMTP in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Grooveli City <no-reply@grooveli.local>

# Private file storage (any S3-compatible service). Local: SeaweedFS from docker-compose.
# On AWS S3: leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false, S3_SSE=true.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=grooveli-files
S3_ACCESS_KEY_ID=grooveli
S3_SECRET_ACCESS_KEY=grooveli-dev-secret
S3_FORCE_PATH_STYLE=true
S3_SSE=false

# AI career assistant (Claude). Leave empty to switch the assistant off (endpoints return 503).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Markets billboard: open-er-api = live FX rates (USD/GBP/EUR → NGN) from https://www.exchangerate-api.com (free, attribution shown).
# Leave empty to switch the billboard off (endpoint returns 503).
MARKETS_PROVIDER=

# ── Needed later ──
# REDIS_URL=redis://localhost:6379   (shared rate limits/presence when running more than one API instance)
