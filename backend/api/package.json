{
  "name": "@grooveli/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:prod": "prisma migrate deploy && node dist/main",
    "lint": "tsc --noEmit",
    "openapi:export": "nest build && node dist/openapi/export.js",
    "openapi:check": "nest build && node dist/openapi/export.js && node scripts/validate-openapi.cjs",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:content": "nest build && node dist/content/load-content.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "seed:export": "node scripts/export-frontend-fixtures.cjs",
    "db:seed": "nest build && node dist/seed/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@grooveli/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.2",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.0"
  }
}
