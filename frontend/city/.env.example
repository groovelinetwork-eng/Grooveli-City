# Public values only.
VITE_WEB_URL=http://localhost:3000
# mock = simulated presence/public fixtures; api = fail visibly until backend exists
VITE_DATA_MODE=mock
# Market charts page opened by the Global Markets billboard (absolute http(s) URL).
# NEEDS PRODUCT CONFIRMATION — leave empty until a destination is approved; the board then explains it isn't set up.
VITE_MARKETS_URL=
# Backend market feed for the Global Markets billboard (docs/MARKETS_FEED_CONTRACT.md).
# Empty = built-in mock feed (simulated, labelled on the board). Absolute http(s) URL or same-origin path.
VITE_MARKETS_FEED_URL=
# Billboard refresh interval in seconds (minimum 15; default 30 mock / 60 live).
VITE_MARKETS_REFRESH_SECONDS=
