# Copy to .env.local. All values are public (NEXT_PUBLIC_*) — never put secrets here.
# mock = synthetic local data; api = typed HTTP adapters (fail visibly until backend contracts exist)
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Where the web app links to the city. Default uses the same-origin /city proxy.
NEXT_PUBLIC_CITY_URL=/city/
# Dev proxy target for /city rewrites
CITY_DEV_ORIGIN=http://localhost:3001
